# QuickShare Environment Variables Template

# Server & Port
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=quickshare
DB_PASSWORD=quickshare_secret
DB_NAME=quickshare_db

# Google Drive OAuth 2.0 Credentials (REQUIRED FOR LIVE DRIVE STORAGE)
# Scope needed: https://www.googleapis.com/auth/drive.file
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=1//your-google-oauth-refresh-token
GOOGLE_DRIVE_FOLDER_NAME=QuickShare Uploads

# File Expiration & Limits
FILE_EXPIRATION_MINUTES=30
MAX_UPLOAD_SIZE_BYTES=5368709120

# Admin Secret API Key
ADMIN_API_KEY=quickshare_admin_secret_key_123
